# Example values only. Copy to .env and fill in your own project's values.
# Never commit the real file; .env is git-ignored.
#
#   flutter build apk --release --dart-define-from-file=.env
#
# The anon key is the only key a mobile app may hold.
# A service role key must never ship inside the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
